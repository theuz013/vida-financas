{
  "name": "vida-financas",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply vida-financas-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vida-financas-db --remote",
    "cf-typegen": "wrangler types --strict-vars=false worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^2.0.0",
    "@tanstack/react-query": "^5.108.4",
    "better-auth": "^1.7.28",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.23",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  }
}
