{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vida-financas",
  // Conta Cloudflare PRÓPRIA deste app, separada de qualquer outro projeto (ex.: avantclinic).
  // Preencha com o Account ID da conta nova (painel da Cloudflare → Workers & Pages → Account ID).
  // Com o id fixo aqui, o deploy nunca cai em outra conta, mesmo que o wrangler esteja logado em várias.
  "account_id": "500998df99884b0a5d4b9768f1a32fc3",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vida-financas-db",
      "database_id": "902f56ea-6ea4-43f4-a2fa-b43367fec331",
      "migrations_dir": "migrations"
    }
  ],
  // A cada 15 min: resumo do dia às 08h (fuso do usuário) e lembretes de compromissos
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "APP_TIMEZONE": "America/Sao_Paulo",
    // "true" libera cadastro público (lojas). Fechado no MVP: só o primeiro usuário se cadastra.
    "ALLOW_SIGNUP": "false",
    // "true" libera o botão "Entrar no modo demonstração" (revisão da Apple/Google)
    "DEMO_ENABLED": "true",
    "VAPID_SUBJECT": "https://vida-financas.vida-financas.workers.dev"
  },
  "observability": { "enabled": true }
}
